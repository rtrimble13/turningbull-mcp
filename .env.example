# turningbull-mcp — single shared env file for every connector in this repo.
# Copy to `.env` and fill in the values you actually need. Each connector
# only consults the variables in its own namespace.

# ---- fmp_mcp --------------------------------------------------------------
# Required: Financial Modeling Prep API key.
# Get one at https://site.financialmodelingprep.com/
FMP_API_KEY=

# Optional: directory where large FMP result sets (CSV/Parquet) are written.
# Defaults to ./fmp_output if unset. Must be writable.
FMP_OUTPUT_DIR=./fmp_output

# ---- bls_mcp --------------------------------------------------------------
# Optional but strongly recommended: US Bureau of Labor Statistics API key.
# Without one the server falls back to the v1 endpoint (25 queries/day,
# 10-year cap, no calculations/annual-average/catalog).
# Register at https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Optional: directory where large BLS result sets (CSV/Parquet) are written
# when bls_get_series is called with mode=summary. Defaults to ./bls_output.
BLS_OUTPUT_DIR=./bls_output

# ---- future connectors ----------------------------------------------------
# Use the connector name as the env-var prefix, e.g.:
#   FOO_API_KEY=
#   FOO_OUTPUT_DIR=./foo_output
