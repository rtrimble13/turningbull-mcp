# turningbull-mcp — single shared env file for every connector in this repo.
# Copy to `.env` and fill in the values you actually need. Each connector
# only consults the variables in its own namespace.

# ---- fmp_mcp --------------------------------------------------------------
# Required: Financial Modeling Prep API key.
# Get one at https://site.financialmodelingprep.com/
FMP_API_KEY=

# Optional: directory where large FMP result sets (CSV/Parquet) are written.
# Defaults to ./fmp_output if unset. Must be writable.
FMP_OUTPUT_DIR=./fmp_output

# ---- bls_mcp --------------------------------------------------------------
# Optional but strongly recommended: US Bureau of Labor Statistics API key.
# Without one the server falls back to the v1 endpoint (25 queries/day,
# 10-year cap, no calculations/annual-average/catalog/aspects). Discovery
# tools (search, build_series_id, describe_series, list_areas, list_items)
# work without a key in any case.
# Register at https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Optional: directory where large BLS result sets (CSV/Parquet) are written
# when bls_get_series is called with mode=summary. Defaults to ./bls_output.
BLS_OUTPUT_DIR=./bls_output

# ---- bea_mcp --------------------------------------------------------------
# Required: US Bureau of Economic Analysis API key (the BEA docs call it
# "UserID"). The BEA API requires it on every call — there is no anonymous
# fallback. Register for a free 36-character key at
# https://apps.bea.gov/API/signup/
BEA_API_KEY=

# Optional: directory where large BEA result sets (CSV/Parquet) are written
# when tools are called with mode=summary. Defaults to ./bea_output.
BEA_OUTPUT_DIR=./bea_output

# ---- ag_mcp ---------------------------------------------------------------
# Required: absolute path to the compiled `ag` binary from the arima-garch
# C++ project. The connector shells out to this binary for every model
# fit/select/forecast/simulate/diagnostics call. Build instructions live
# in the arima-garch README; the binary is typically at
# `<repo>/build/ninja-release/src/ag`. If unset, the connector also tries
# `shutil.which("ag")` and falls back with a clear error.
AG_BINARY_PATH=

# Optional: directory where ag_mcp persists prices/series/returns CSVs,
# fitted model JSONs, forecast CSVs, simulation CSVs, and diagnostics
# JSONs. Subdirectories (prices/, series/, returns/, models/, forecasts/,
# simulations/, diagnostics/) are created on first use.
# Defaults to ./ag_output.
AG_OUTPUT_DIR=./ag_output

# Optional: max wall-clock seconds for a single `ag` subprocess call.
# Default 600. Cross-validation model selection (criterion=CV) can be
# slow; raise this if you hit timeouts on legitimate runs.
AG_SUBPROCESS_TIMEOUT=600

# ---- future connectors ----------------------------------------------------
# Use the connector name as the env-var prefix, e.g.:
#   FOO_API_KEY=
#   FOO_OUTPUT_DIR=./foo_output
